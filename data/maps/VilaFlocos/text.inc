VilaFlocos_Text_Sign::
    .string "VILA FLOCOS\n"
    .string "A neve guarda os segredos de SERRA.$"

VilaFlocos_Text_Researcher::
    .string "Bem-vindo a SERRA!\p"
    .string "A ilha está mudando. As geleiras\n"
    .string "estão começando a derreter.\p"
    .string "Preciso que você viaje pela região\n"
    .string "e descubra o que está causando isso.\p"
    .string "Leve este SNOLET. Ele conhece bem\n"
    .string "o frio das nossas montanhas.$"

VilaFlocos_Text_ReceivedSnolet::
    .string "Você recebeu SNOLET!$"

VilaFlocos_Text_AlreadyGotStarter::
    .string "Cuide bem do SNOLET. A ilha precisa\n"
    .string "de alguém que possa protegê-la.$"

VilaFlocos_Text_Lugia::
    .string "Uma antiga lenda de SERRA fala\n"
    .string "sobre LUGIA, guardião do gelo.\p"
    .string "Ele respondeu ao chamado da ilha\n"
    .string "e deseja acompanhar você.$"

VilaFlocos_Text_LugiaReceived::
    .string "LUGIA DE SERRA se juntou à sua\n"
    .string "equipe!$"

VilaFlocos_Text_LugiaAlready::
    .string "LUGIA já está viajando com você.$"

VilaFlocos_Text_HoOh::
    .string "As cinzas desta ave lendária\n"
    .string "ainda guardam uma chama de vida.\p"
    .string "Traga 10 MAX REVIVES para\n"
    .string "restaurá-la.$"

VilaFlocos_Text_HoOhNeedItems::
    .string "Você precisa de 10 MAX REVIVES.\n"
    .string "Ainda não tenho o bastante.$"

VilaFlocos_Text_HoOhRevived::
    .string "As 10 MAX REVIVES brilham!\p"
    .string "HO-OH regional renasceu das\n"
    .string "cinzas e reconhece sua coragem!$"

VilaFlocos_Text_HoOhCaptured::
    .string "HO-OH foi capturado e se juntou\n"
    .string "à sua equipe!$"

VilaFlocos_Text_HoOhAlready::
    .string "HO-OH já renasceu e está com você.$"
